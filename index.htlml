<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LexPulse — Veille juridique numérique</title>
<style>
  :root {
    --bg: #f8f7f4;
    --surface: #ffffff;
    --border: #e8e5df;
    --text: #1a1a1a;
    --muted: #6b6860;
    --accent: #2d4a8a;
    --accent-light: #eef2fb;
    --tag-rgpd: #1d6e56; --tag-rgpd-bg: #e1f5ee;
    --tag-ai: #533ab7; --tag-ai-bg: #eeedfe;
    --tag-dsa: #993c1d; --tag-dsa-bg: #faece7;
    --tag-sante: #185fa5; --tag-sante-bg: #e6f1fb;
    --tag-juris: #854f0b; --tag-juris-bg: #faeeda;
    --tag-legis: #3b6d11; --tag-legis-bg: #eaf3de;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); font-size: 15px; line-height: 1.6; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* HEADER */
  header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 0 2rem; position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .logo { font-size: 18px; font-weight: 700; color: var(--accent); letter-spacing: -0.5px; }
  .logo span { color: var(--text); font-weight: 400; font-size: 13px; margin-left: 8px; color: var(--muted); }
  .header-date { font-size: 12px; color: var(--muted); }

  /* LAYOUT */
  .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; display: grid; grid-template-columns: 1fr 340px; gap: 2rem; }
  @media (max-width: 800px) { .container { grid-template-columns: 1fr; } }

  /* SECTION TITLES */
  .section-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 1.25rem; }

  /* TAGS */
  .tag { display: inline-block; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 7px; border-radius: 4px; }
  .tag-rgpd { background: var(--tag-rgpd-bg); color: var(--tag-rgpd); }
  .tag-ai { background: var(--tag-ai-bg); color: var(--tag-ai); }
  .tag-dsa { background: var(--tag-dsa-bg); color: var(--tag-dsa); }
  .tag-sante { background: var(--tag-sante-bg); color: var(--tag-sante); }
  .tag-juris { background: var(--tag-juris-bg); color: var(--tag-juris); }
  .tag-legis { background: var(--tag-legis-bg); color: var(--tag-legis); }

  /* NOTE HEBDO */
  .note-hebdo { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem; }
  .note-hebdo-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; }
  .note-hebdo h2 { font-size: 20px; font-weight: 700; line-height: 1.3; }
  .note-hebdo .meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .note-hebdo-body { font-size: 14px; line-height: 1.75; color: #2a2a2a; }
  .note-hebdo-body h3 { font-size: 14px; font-weight: 600; margin: 1rem 0 0.4rem; color: var(--accent); }
  .note-hebdo-body p { margin-bottom: 0.75rem; }
  .note-hebdo-body .avant-apres { background: #f8f7f4; border-left: 3px solid var(--accent); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin: 0.75rem 0; font-size: 13px; }
  .note-hebdo-body .avant-apres strong { display: block; margin-bottom: 2px; color: var(--accent); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
  .read-more { display: inline-block; margin-top: 1rem; font-size: 13px; color: var(--accent); font-weight: 500; cursor: pointer; border: none; background: none; padding: 0; }

  /* ARTICLES COURTS */
  .article-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; transition: border-color 0.15s; }
  .article-card:hover { border-color: #b0bdd8; }
  .article-card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .article-card h3 { font-size: 14px; font-weight: 600; line-height: 1.4; margin-bottom: 4px; }
  .article-card p { font-size: 13px; color: var(--muted); line-height: 1.55; }
  .article-card .article-meta { font-size: 11px; color: var(--muted); margin-top: 8px; display: flex; align-items: center; gap: 12px; }
  .article-card .impact { font-size: 11px; font-weight: 500; }
  .impact-high { color: #a32d2d; }
  .impact-med { color: #854f0b; }
  .impact-low { color: #3b6d11; }

  /* SIDEBAR */
  .sidebar {}
  .widget { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.25rem; }
  .widget-title { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); margin-bottom: 1rem; }
  .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
  .stat-row:last-child { border-bottom: none; }
  .stat-num { font-weight: 700; color: var(--accent); font-size: 18px; }

  /* CHAT */
  .chat-widget { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .chat-title { padding: 1rem 1.25rem; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 6px; }
  .chat-title::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #3b6d11; display: inline-block; }
  #chat-messages { height: 300px; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .msg { max-width: 88%; font-size: 13px; line-height: 1.55; padding: 8px 12px; border-radius: 10px; }
  .msg-bot { background: var(--accent-light); color: var(--text); align-self: flex-start; border-radius: 2px 10px 10px 10px; }
  .msg-user { background: var(--accent); color: #fff; align-self: flex-end; border-radius: 10px 10px 2px 10px; }
  .msg-loading { color: var(--muted); font-style: italic; }
  .chat-input-area { padding: 0.75rem; border-top: 1px solid var(--border); display: flex; gap: 8px; }
  #chat-input { flex: 1; border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 13px; font-family: inherit; outline: none; resize: none; }
  #chat-input:focus { border-color: var(--accent); }
  #chat-send { background: var(--accent); color: #fff; border: none; border-radius: 6px; padding: 8px 14px; font-size: 13px; cursor: pointer; white-space: nowrap; }
  #chat-send:hover { background: #1f3570; }
  .suggestions { padding: 0 1rem 0.75rem; display: flex; flex-wrap: wrap; gap: 6px; }
  .suggest-btn { font-size: 11px; border: 1px solid var(--border); border-radius: 20px; padding: 4px 10px; background: var(--bg); cursor: pointer; color: var(--muted); transition: all 0.15s; }
  .suggest-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }

  /* LOADING */
  #loading { text-align: center; padding: 3rem; color: var(--muted); font-size: 14px; }
  .spinner { width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 1rem; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* FILTERS */
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .filter-btn { font-size: 12px; padding: 4px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; color: var(--muted); transition: all 0.15s; }
  .filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .filter-btn:hover:not(.active) { border-color: var(--accent); color: var(--accent); }

  /* ALERT BANNER */
  .update-banner { background: var(--accent-light); border: 1px solid #b0c0e0; border-radius: 8px; padding: 10px 16px; font-size: 13px; color: var(--accent); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px; }
</style>
</head>
<body>

<header>
  <div class="logo">LexPulse <span>Veille droit du numérique</span></div>
  <div class="header-date" id="header-date"></div>
</header>

<div id="loading">
  <div class="spinner"></div>
  Chargement de la veille en cours…
</div>

<div class="container" id="main-content" style="display:none">

  <!-- COLONNE PRINCIPALE -->
  <main>
    <div class="update-banner" id="update-banner"></div>

    <!-- NOTE HEBDOMADAIRE -->
    <div class="section-title">Note hebdomadaire</div>
    <div class="note-hebdo" id="note-hebdo-container"></div>

    <!-- ARTICLES COURTS -->
    <div class="section-title" style="margin-top:2rem">Actualités récentes</div>
    <div class="filters" id="filters">
      <button class="filter-btn active" onclick="filterArticles('all')">Tout</button>
      <button class="filter-btn" onclick="filterArticles('rgpd')">RGPD</button>
      <button class="filter-btn" onclick="filterArticles('ai')">AI Act</button>
      <button class="filter-btn" onclick="filterArticles('sante')">Santé</button>
      <button class="filter-btn" onclick="filterArticles('juris')">Jurisprudence</button>
      <button class="filter-btn" onclick="filterArticles('legis')">Législation</button>
    </div>
    <div id="articles-container"></div>
  </main>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <!-- STATS -->
    <div class="widget">
      <div class="widget-title">Cette semaine</div>
      <div id="stats-container"></div>
    </div>

    <!-- AGENT CONVERSATIONNEL -->
    <div class="chat-widget">
      <div class="chat-title">Agent juridique</div>
      <div id="chat-messages">
        <div class="msg msg-bot">Bonjour ! Je suis votre assistant juridique. Posez-moi une question sur l'actualité de la semaine ou demandez-moi d'approfondir un sujet.</div>
      </div>
      <div class="suggestions" id="suggestions"></div>
      <div class="chat-input-area">
        <textarea id="chat-input" rows="2" placeholder="Ex : Explique la décision CNIL sur Meta…"></textarea>
        <button id="chat-send" onclick="sendChat()">Envoyer</button>
      </div>
    </div>

  </aside>
</div>

<script>
const DATA_URL = 'data/veille.json';
let allArticles = [];
let veillData = null;

async function init() {
  try {
    const r = await fetch(DATA_URL + '?t=' + Date.now());
    if (!r.ok) throw new Error('no data');
    veillData = await r.json();
    render(veillData);
  } catch(e) {
    document.getElementById('loading').innerHTML = '<p style="color:#a32d2d">Données non disponibles. Lancez le workflow GitHub Actions pour générer la première veille.</p>';
  }
}

function render(data) {
  document.getElementById('loading').style.display = 'none';
  document.getElementById('main-content').style.display = 'grid';
  document.getElementById('header-date').textContent = new Date(data.generated_at).toLocaleDateString('fr-FR', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
  document.getElementById('update-banner').innerHTML = `<span>⟳</span> Dernière mise à jour : ${new Date(data.generated_at).toLocaleString('fr-FR')} — ${data.articles.length} actualités collectées depuis avril 2025`;

  renderNoteHebdo(data.note_hebdo);
  allArticles = data.articles;
  renderArticles(allArticles);
  renderStats(data);
  renderSuggestions(data.suggestions || []);
}

function renderNoteHebdo(note) {
  const c = document.getElementById('note-hebdo-container');
  c.innerHTML = `
    <div class="note-hebdo-header">
      <div>
        <div style="display:flex;gap:6px;margin-bottom:8px">${(note.tags||[]).map(t=>`<span class="tag tag-${t.toLowerCase()}">${t}</span>`).join('')}</div>
        <h2>${note.title}</h2>
        <div class="meta">Semaine du ${note.week} · Note analytique</div>
      </div>
    </div>
    <div class="note-hebdo-body" id="note-body-short">${note.intro}</div>
    <div class="note-hebdo-body" id="note-body-full" style="display:none">${note.full_content}</div>
    <button class="read-more" id="read-more-btn" onclick="toggleNote()">Lire la note complète →</button>
  `;
}

function toggleNote() {
  const s = document.getElementById('note-body-short');
  const f = document.getElementById('note-body-full');
  const b = document.getElementById('read-more-btn');
  if (f.style.display === 'none') {
    f.style.display = 'block'; s.style.display = 'none';
    b.textContent = '← Réduire';
  } else {
    f.style.display = 'none'; s.style.display = 'block';
    b.textContent = 'Lire la note complète →';
  }
}

function renderArticles(articles) {
  const c = document.getElementById('articles-container');
  if (!articles.length) { c.innerHTML = '<p style="color:var(--muted);font-size:13px">Aucun article dans cette catégorie.</p>'; return; }
  c.innerHTML = articles.map(a => `
    <div class="article-card" data-cat="${a.category}">
      <div class="article-card-header">
        <span class="tag tag-${a.category}">${a.category_label}</span>
        <span style="font-size:11px;color:var(--muted)">${a.date}</span>
      </div>
      <h3>${a.title}</h3>
      <p>${a.summary}</p>
      ${a.analysis ? `<div style="font-size:13px;color:var(--text);margin-top:8px;padding-top:8px;border-top:1px solid var(--border)">${a.analysis}</div>` : ''}
      ${a.avant_apres ? `<div class="avant-apres"><strong>Avant / Après</strong>${a.avant_apres}</div>` : ''}
      <div class="article-meta">
        <span>Source : ${a.source}</span>
        ${a.impact ? `<span class="impact impact-${a.impact_level}">Impact ${a.impact}</span>` : ''}
        ${a.url ? `<a href="${a.url}" target="_blank" style="font-size:11px">Lire →</a>` : ''}
      </div>
    </div>
  `).join('');
}

function filterArticles(cat) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  const filtered = cat === 'all' ? allArticles : allArticles.filter(a => a.category === cat);
  renderArticles(filtered);
}

function renderStats(data) {
  const s = data.stats || {};
  document.getElementById('stats-container').innerHTML = `
    <div class="stat-row"><span>Textes collectés</span><span class="stat-num">${s.total||0}</span></div>
    <div class="stat-row"><span>RGPD / données</span><span class="stat-num">${s.rgpd||0}</span></div>
    <div class="stat-row"><span>AI Act / IA</span><span class="stat-num">${s.ai||0}</span></div>
    <div class="stat-row"><span>Santé / HDS</span><span class="stat-num">${s.sante||0}</span></div>
    <div class="stat-row"><span>Jurisprudence</span><span class="stat-num">${s.juris||0}</span></div>
    <div class="stat-row"><span>Législation EU</span><span class="stat-num">${s.legis||0}</span></div>
  `;
}

function renderSuggestions(suggs) {
  document.getElementById('suggestions').innerHTML = suggs.map(s =>
    `<button class="suggest-btn" onclick="quickChat('${s.replace(/'/g,"\\'")} ')">${s}</button>`
  ).join('');
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const q = input.value.trim();
  if (!q) return;
  input.value = '';
  appendMsg(q, 'user');
  const loading = appendMsg('…', 'bot loading');

  const context = veillData ? `Voici les données de veille juridique disponibles (semaine du ${veillData.note_hebdo?.week}) :
NOTE HEBDO: ${veillData.note_hebdo?.full_content?.replace(/<[^>]+>/g,'')||''}
ARTICLES: ${(veillData.articles||[]).map(a=>`[${a.category_label}] ${a.title} — ${a.summary}`).join('\n')}` : '';

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: `Tu es un assistant juridique spécialisé en droit du numérique, RGPD, AI Act et droit de la santé. Tu travailles pour une juriste stagiaire (Alex) en conformité dans un contexte universitaire et institutionnel (AMU, AP-HM, CNRS). Réponds en français, de manière précise et analytique, comme un juriste s'adressant à un pair. Appuie-toi sur le contexte de veille fourni quand c'est pertinent.\n\n${context}`,
        messages: [{role:'user', content:q}]
      })
    });
    const d = await r.json();
    loading.remove();
    appendMsg(d.content[0].text, 'bot');
  } catch(e) {
    loading.remove();
    appendMsg('Erreur de connexion à l\'agent.', 'bot');
  }
}

function quickChat(q) {
  document.getElementById('chat-input').value = q;
  sendChat();
}

function appendMsg(text, type) {
  const box = document.getElementById('chat-messages');
  const d = document.createElement('div');
  d.className = `msg msg-${type.includes('bot')?'bot':'user'}${type.includes('loading')?' msg-loading':''}`;
  d.innerHTML = text.replace(/\n/g,'<br>');
  box.appendChild(d);
  box.scrollTop = box.scrollHeight;
  return d;
}

document.getElementById('chat-input').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChat(); }
});

document.getElementById('header-date').textContent = new Date().toLocaleDateString('fr-FR', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
init();
</script>
</body>
</html>
